{
	"name": "tylasu-hello-world",
	"description": "Hello World with Tylasu and ANTLR4.",
	"author": "Strumenta s.r.l.",
	"publisher": "strumenta",
	"version": "1.2.1",
	"license": "Apache 2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/strumenta/tylasu-hello-world"
	},
	"engines": {
		"node": "*"
	},
	"files": [
		"dist",
		"src/**/*.ts",
		"src/**/*.g4",
		"package.json"
	],
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"dependencies": {
		"@strumenta/tylasu": "^1.6.30",
		"antlr4ng": "^3.0.15",
		"assert": "^2.1.0",
		"process": "^0.11.10",
		"util": "^0.12.5"
	},
	"devDependencies": {
		"@tsconfig/recommended": "^1.0.1",
		"@types/chai": "^4.2.11",
		"@types/mocha": "^5.2.7",
		"@types/node": "^13.9.8",
		"@typescript-eslint/eslint-plugin": "^4.11.0",
		"@typescript-eslint/parser": "^4.11.0",
		"chai": "^4.2.0",
		"cross-env": "^7.0.3",
		"eslint": "^7.16.0",
		"merge-options": "^2.0.0",
		"mocha": "^11.1.0",
		"rimraf": "^3.0.0",
		"source-map-loader": "^4.0.1",
		"ts-loader": "^6.2.2",
		"ts-node": "^10.9.2",
		"typescript": "^5.6.3",
		"webpack": "^5.98.0",
		"webpack-cli": "^6.0.1"
	},
	"scripts": {
		"clean": "rimraf dist && rimraf *.tgz",
		"build": "npm run gen:parser && npm run build:browser && npm run build:esm && npm run build:cjs",
		"build:browser": "cross-env NODE_ENV=production webpack",
		"build:cjs": "tsc --module commonjs --outDir dist/cjs",
		"build:esm": "tsc --module es6 --outDir dist/esm",
		"gen:parser": "npx antlr-ng -Dlanguage=TypeScript -o src/parser -visitor src/grammar/SimpleLangLexer.g4 src/grammar/SimpleLangParser.g4",
		"lint": "eslint src"
	}
}
